# ==============================================================================
# INFINITE BRIGHT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# In production (Vercel / Netlify / VPS), configure these environment variables
# in the hosting platform's dashboard.
# ==============================================================================

# --- 1. CORE APPLICATION DOMAIN ---
# Canonical domain used for absolute URLs in metadata, sitemap.xml, and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://infinitebright.com

# --- 2. OFFICIAL CLIENT CHANNELS ---
# Direct Saudi contact number for WhatsApp Concierge and click-to-chat links
# International format without '+' or spaces (e.g., 966534422257)
NEXT_PUBLIC_WHATSAPP_NUMBER=966534422257
NEXT_PUBLIC_PHONE_DISPLAY=+966 53 442 2257

# --- 3. ANALYTICS & TAG MANAGERS (OPTIONAL) ---
# Uncomment and configure with official Google Tag Manager or GA4 ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX

# --- 4. FEATURE FLAGS (OPTIONAL OVERRIDES) ---
# Override feature flags defined in `src/config/site.config.ts` if needed
# NEXT_PUBLIC_ENABLE_3D_HERO=true
# NEXT_PUBLIC_DEFAULT_THEME=light

